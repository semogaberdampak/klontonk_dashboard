# Opsional. Tanpa berkas ini, aplikasi memakai project Supabase bawaan (nuxt.config.ts).
# Nilai di bawah PUBLIK (publishable key). JANGAN pernah mengisi kunci secret / service_role.
NUXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=sb_publishable_xxx

# Mode demo: data contoh tanpa Supabase dan tanpa login (atau pakai `npm run dev:demo` / `npm run build:demo`).
# NUXT_PUBLIC_DEMO_MODE=true
