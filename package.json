{
  "name": "klontonk-dashboard",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Dashboard manajemen Klontonk POS (Nuxt 4 + TypeScript, pola MVC)",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "dev:demo": "NUXT_PUBLIC_DEMO_MODE=true nuxt dev --host 127.0.0.1",
    "build": "nuxt generate && node scripts/inject-csp.mjs",
    "build:demo": "NUXT_PUBLIC_DEMO_MODE=true npm run build",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "nuxt": "^4.6.1",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.13"
  }
}
